#!/bin/bash
#
# better-rm - A safer rm command that moves files to trash instead of permanent deletion
# 更安全的 rm 命令，將檔案移至垃圾桶而非永久刪除
#

# 設定垃圾桶目錄 (可透過環境變數 TRASH_DIR 更改)
# Set trash directory (can be changed via TRASH_DIR environment variable)
TRASH_DIR="${TRASH_DIR:-$HOME/.Trash}"

# 解析 better-rm 狀態目錄
# Resolve the better-rm state directory
resolve_state_dir() {
    if [ -n "${BETTER_RM_STATE_DIR:-}" ]; then
        printf '%s\n' "$BETTER_RM_STATE_DIR"
    elif [[ "${XDG_STATE_HOME:-}" = /* ]]; then
        printf '%s/better-rm\n' "$XDG_STATE_HOME"
    else
        printf '%s/.local/state/better-rm\n' "$HOME"
    fi
}

# 取得刪除日誌路徑
# Get the deletion log path
get_deletion_log_file() {
    local state_dir
    state_dir=$(resolve_state_dir)
    printf '%s/deletion.log\n' "$state_dir"
}

# 受保護的目錄清單 - 禁止刪除這些重要目錄
# Protected directories list - prevent deletion of these critical directories
PROTECTED_DIRS=(
    "/"
    "/bin"
    "/boot"
    "/dev"
    "/etc"
    "/home"
    "/lib"
    "/lib64"
    "/mnt"
    "/opt"
    "/proc"
    "/root"
    "/sbin"
    "/sys"
    "/usr"
    "/var"
    "$HOME"
    "$HOME/"
)

# 受保護的目錄模式清單 (使用萬用字元)
# Protected directory patterns (using wildcards)
PROTECTED_PATTERNS=(
    ".git"
    ".git/"
    "*/.git"
    "*/.git/"
)

# 顏色定義 (Color definitions)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 顯示錯誤訊息
# Display error message
error_msg() {
    echo -e "${RED}錯誤 (Error): $1${NC}" >&2
}

# 顯示警告訊息
# Display warning message
warn_msg() {
    echo -e "${YELLOW}警告 (Warning): $1${NC}" >&2
}

# 顯示成功訊息
# Display success message
success_msg() {
    echo -e "${GREEN}$1${NC}"
}

# 記錄刪除操作到日誌檔案
# Log deletion operation to log file
log_deletion() {
    local original_path="$1"
    local trash_path="$2"
    local file_hash="$3"
    local timestamp="$4"
    local file_type="$5"
    local log_file
    local log_dir
    log_file=$(get_deletion_log_file)
    log_dir="${log_file%/*}"

    # 確保狀態目錄存在，並限制新目錄的存取權限
    # Ensure the state directory exists with restrictive permissions
    if [ ! -d "$log_dir" ]; then
        if ! (umask 077; mkdir -p "$log_dir") 2>/dev/null; then
            warn_msg "無法建立日誌目錄: $log_dir"
            warn_msg "Failed to create log directory: $log_dir"
            return 1
        fi
    fi
    
    # 確保日誌檔案存在
    # Ensure log file exists
    if [ ! -f "$log_file" ]; then
        if ! (
            umask 077
            {
                echo "# Better-RM Deletion Log"
                echo "# 更好的 RM 刪除日誌"
                echo "# Format: TIMESTAMP | ORIGINAL_PATH | TRASH_PATH | HASH | FILE_TYPE"
                echo "# 格式：時間戳記 | 原始路徑 | 垃圾桶路徑 | 雜湊值 | 檔案類型"
                echo "# =============================================================================="
            } > "$log_file"
        ) 2>/dev/null; then
            # 日誌檔案創建失敗，顯示警告但不中斷操作
            # Log file creation failed, show warning but don't interrupt operation
            warn_msg "無法創建刪除日誌: $log_file"
            warn_msg "Failed to create deletion log: $log_file"
            return 1
        fi
    fi
    
    # 記錄刪除操作
    # Log the deletion operation
    if ! {
        printf '%s | %s | %s | %s | %s\n' \
            "$timestamp" "$original_path" "$trash_path" "$file_hash" "$file_type" >> "$log_file"
    } 2>/dev/null; then
        # 記錄失敗，顯示警告但不中斷操作
        # Logging failed, show warning but don't interrupt operation
        warn_msg "無法寫入刪除日誌"
        warn_msg "Failed to write to deletion log"
        return 1
    fi
}

# 正規化路徑函式
# Normalize path function
normalize_path() {
    local path="$1"
    # 移除多餘的斜線
    # Remove multiple slashes
    path=$(echo "$path" | sed 's#/\+#/#g')
    
    # 處理 ./ 和 ../
    # Handle ./ and ../
    local IFS='/'
    local parts=()
    local part
    
    for part in $path; do
        if [ "$part" = ".." ]; then
            # 移除上一個元素（如果存在）
            if [ ${#parts[@]} -gt 0 ]; then
                unset 'parts[${#parts[@]}-1]'
                parts=("${parts[@]}")  # 重新索引陣列
            fi
        elif [ "$part" != "." ] && [ -n "$part" ]; then
            parts+=("$part")
        fi
    done
    
    # 重建路徑
    local normalized=""
    if [[ "$path" = /* ]]; then
        normalized="/"
    fi
    
    local first=1
    for part in "${parts[@]}"; do
        if [ $first -eq 1 ]; then
            normalized="${normalized}${part}"
            first=0
        else
            normalized="${normalized}/${part}"
        fi
    done
    
    # 如果結果為空且原始路徑以 / 開頭，返回 /
    if [ -z "$normalized" ] && [[ "$path" = /* ]]; then
        normalized="/"
    fi
    
    echo "$normalized"
}

# 檢查路徑是否為受保護的目錄
# Check if path is a protected directory
is_protected() {
    local path="$1"
    local real_path
    
    # 取得絕對路徑
    # Get absolute path
    if [ -e "$path" ] || [ -L "$path" ]; then
        # 如果檔案存在，使用 readlink/realpath
        real_path=$(readlink -f "$path" 2>/dev/null)
        if [ -z "$real_path" ]; then
            real_path=$(realpath "$path" 2>/dev/null)
        fi
        if [ -z "$real_path" ]; then
            # 兩者都失敗，手動解析
            if [[ "$path" = /* ]]; then
                real_path="$path"
            else
                real_path="$(pwd)/$path"
            fi
            real_path=$(normalize_path "$real_path")
        fi
    else
        # 如果路徑不存在，嘗試解析相對路徑
        # If path doesn't exist, try to resolve relative path
        if [[ "$path" = /* ]]; then
            real_path="$path"
        else
            real_path="$(pwd)/$path"
        fi
        real_path=$(normalize_path "$real_path")
    fi
    
    # 移除結尾的斜線以便比較
    # Remove trailing slash for comparison
    real_path="${real_path%/}"

    # 計算未解析符號連結的標準化絕對路徑，以支援如 macOS 的 /home, /etc, /var 等符號連結目錄的保護
    # Calculate normalized absolute path without symlink resolution to support directory symlinks like /home, /etc, /var on macOS
    local norm_path
    if [[ "$path" = /* ]]; then
        norm_path="$path"
    else
        norm_path="$(pwd)/$path"
    fi
    norm_path=$(normalize_path "$norm_path")
    norm_path="${norm_path%/}"
    
    # 檢查是否與受保護目錄完全符合
    # Check if exactly matches protected directories
    for protected in "${PROTECTED_DIRS[@]}"; do
        protected="${protected%/}"
        if [ "$real_path" = "$protected" ] || [ "$norm_path" = "$protected" ]; then
            return 0  # 是受保護的目錄
        fi
    done

    # 保護 /mnt 本身及其第一層掛載根（例如 WSL 的 /mnt/c），但允許操作掛載點內的項目
    # Protect /mnt and its immediate mount roots (for example /mnt/c on WSL), while allowing items inside them
    local candidate remainder
    for candidate in "$real_path" "$norm_path"; do
        if [[ "$candidate" = /mnt/* ]]; then
            remainder="${candidate#/mnt/}"
            if [ -n "$remainder" ] && [[ "$remainder" != */* ]]; then
                return 0
            fi
        fi
    done

    # 檢查是否符合受保護的模式
    # Check if matches protected patterns
    local basename_path=$(basename "$real_path")
    local basename_norm=$(basename "$norm_path")
    for pattern in "${PROTECTED_PATTERNS[@]}"; do
        pattern="${pattern%/}"
        if [[ "$basename_path" = ${pattern} ]] || [[ "$real_path" = */${pattern} ]] || [[ "$real_path" = ${pattern} ]] || \
           [[ "$basename_norm" = ${pattern} ]] || [[ "$norm_path" = */${pattern} ]] || [[ "$norm_path" = ${pattern} ]]; then
            return 0  # 符合受保護模式
        fi
    done
    
    return 1  # 不是受保護的目錄
}

