# 移動檔案至垃圾桶
# Move file to trash
move_to_trash() {
    local source="$1"
    local verbose="$2"

    # 無論路徑是否存在或是否使用強制模式，都先檢查受保護路徑
    # Always check protected paths first, even when the path is missing or force mode is enabled
    if is_protected "$source"; then
        error_msg "拒絕刪除受保護的目錄: '$source'"
        error_msg "Refused to remove protected directory: '$source'"
        error_msg "這是一個重要的系統目錄或專案目錄！"
        error_msg "This is a critical system or project directory!"
        return 1
    fi

    # 檢查檔案或目錄是否存在
    # Check if file or directory exists
    if [ ! -e "$source" ] && [ ! -L "$source" ]; then
        if [ "$force_mode" != "1" ]; then
            error_msg "無法移除 '$source': 沒有此一檔案或目錄"
            error_msg "cannot remove '$source': No such file or directory"
            return 1
        fi
        return 0  # 在強制模式下，忽略不存在的檔案
    fi
    
    # 取得絕對路徑
    # Get absolute path
    local abs_path
    if [ -e "$source" ] || [ -L "$source" ]; then
        abs_path=$(readlink -f "$source" 2>/dev/null)
        if [ -z "$abs_path" ]; then
            abs_path=$(realpath "$source" 2>/dev/null)
        fi
        if [ -z "$abs_path" ]; then
            # 手動計算絕對路徑
            if [[ "$source" = /* ]]; then
                abs_path="$source"
            else
                abs_path="$(cd "$(dirname "$source")" 2>/dev/null && pwd)/$(basename "$source")"
            fi
        fi
    else
        if [[ "$source" = /* ]]; then
            abs_path="$source"
        else
            abs_path="$(pwd)/$source"
        fi
    fi
    
    # 建立垃圾桶目錄結構
    # Create trash directory structure
    local trash_path="$TRASH_DIR$(dirname "$abs_path")"
    mkdir -p "$trash_path" 2>/dev/null || {
        error_msg "無法建立垃圾桶目錄: $trash_path"
        error_msg "Failed to create trash directory: $trash_path"
        return 1
    }
    
    # 計算檔案內容的 hash 值
    # Calculate hash of file content
    local file_hash=""
    if [ -f "$source" ] && [ ! -L "$source" ]; then
        # 如果是普通檔案（非符號連結），計算 hash
        # If it's a regular file (not a symlink), calculate hash
        file_hash=$(md5sum "$source" 2>/dev/null | cut -d' ' -f1)
        if [ -z "$file_hash" ]; then
            # 如果 md5sum 失敗，使用 sha256sum
            # If md5sum fails, use sha256sum
            file_hash=$(sha256sum "$source" 2>/dev/null | cut -d' ' -f1)
        fi
    elif [ -d "$source" ] && [ ! -L "$source" ]; then
        # 如果是目錄，計算目錄內容的 hash
        # If it's a directory, calculate hash of directory contents
        # 使用 -print0 和 sort -z 以安全處理特殊字元檔名
        # Use -print0 and sort -z to safely handle filenames with special characters
        # 使用 -r 選項以正確處理空目錄
        # Use -r option to correctly handle empty directories
        file_hash=$(find "$source" -type f -print0 2>/dev/null | sort -z | xargs -0 -r md5sum 2>/dev/null | md5sum | cut -d' ' -f1)
        if [ -z "$file_hash" ]; then
            file_hash=$(find "$source" -type f -print0 2>/dev/null | sort -z | xargs -0 -r sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1)
        fi
    fi
    
    # 如果無法計算 hash，使用預設值
    # If hash calculation fails, use default value
    if [ -z "$file_hash" ]; then
        file_hash="nohash"
    fi
    
    # 生成刪除時間戳記（包含奈秒以避免碰撞）
    # Generate deletion timestamp (with nanoseconds to avoid collisions)
    local timestamp=$(date +%Y%m%d_%H%M%S_%N)
    
    # 目標路徑，加上時間戳記和 hash
    # Target path with timestamp and hash
    local target="$TRASH_DIR$abs_path"
    target="${target}__${timestamp}__${file_hash}"
    
    # 判斷檔案類型（在移動之前）
    # Determine file type (before moving)
    local file_type="unknown"
    if [ -d "$source" ] && [ ! -L "$source" ]; then
        file_type="directory"
    elif [ -L "$source" ]; then
        file_type="symlink"
    elif [ -f "$source" ]; then
        file_type="file"
    fi
    
    # 移動檔案到垃圾桶
    # Move file to trash
    if mv "$source" "$target" 2>/dev/null; then
        # 記錄刪除操作到日誌
        # Log the deletion operation
        log_deletion "$abs_path" "$target" "$file_hash" "$timestamp" "$file_type"
        
        if [ "$verbose" = "1" ]; then
            success_msg "已移除 '$source' (moved to trash: $target)"
        fi
        return 0
    else
        error_msg "無法移除 '$source'"
        error_msg "Failed to remove '$source'"
        return 1
    fi
}

# 移除字串前後空白
# Trim leading and trailing whitespace
trim() {
    local var="$*"
    # remove leading whitespace characters
    var="${var#"${var%%[![:space:]]*}"}"
    # remove trailing whitespace characters
    var="${var%"${var##*[![:space:]]}"}"
    echo -n "$var"
}

# 還原檔案
# Restore file
restore_file() {
    local target_name="$1"
    local force="$2"
    local verbose="$3"
    
    local primary_log
    local legacy_log="$TRASH_DIR/.deletion_log"
    local log_file
    local log_files=()
    primary_log=$(get_deletion_log_file)

    if [ -f "$primary_log" ]; then
        log_files+=("$primary_log")
    fi
    if [ -f "$legacy_log" ]; then
        log_files+=("$legacy_log")
    fi

    if [ ${#log_files[@]} -eq 0 ]; then
        error_msg "找不到刪除日誌，無法還原檔案"
        error_msg "Deletion log not found, cannot restore file"
        return 1
    fi
    
    # 從日誌尾部開始尋找符合檔名/路徑的刪除記錄
    # Search from the end of the log for a matching deletion record
    local trash_path=""
    local original_path=""
    local file_hash=""
    local timestamp=""
    local file_type=""
    
    # 依序讀取新日誌與舊版垃圾桶日誌
    # Read the new log first, then the legacy trash log
    local IFS=$'\n'
    local lines=()
    local found=0
    local i
    for log_file in "${log_files[@]}"; do
        lines=()
        if ! {
            while read -r line || [[ -n "$line" ]]; do
                if [[ -n "$line" && ! "$line" =~ ^# ]]; then
                    lines+=("$line")
                fi
            done < "$log_file"
        } 2>/dev/null; then
            continue
        fi

        for ((i=${#lines[@]}-1; i>=0; i--)); do
            local line="${lines[i]}"
            # 解析日誌行：TIMESTAMP | ORIGINAL_PATH | TRASH_PATH | HASH | FILE_TYPE
            local parts=()
            IFS='|' read -r -a parts <<< "$line"

            timestamp=$(trim "${parts[0]}")
            original_path=$(trim "${parts[1]}")
            trash_path=$(trim "${parts[2]}")
            file_hash=$(trim "${parts[3]}")
            file_type=$(trim "${parts[4]}")

            # 檢查 trash_path 是否真的存在於磁碟上
            if [ ! -e "$trash_path" ] && [ ! -L "$trash_path" ]; then
                continue
            fi

            # 比對規則：
            # 1. 如果 target_name 是絕對路徑，則精確比對 original_path
            # 2. 如果 target_name 是相對路徑或僅檔名，則檢查 original_path 是否以 "/target_name" 結尾，或是 original_path 是否等於 "/target_name"
            local match=0
            if [[ "$target_name" = /* ]]; then
                if [ "$original_path" = "$target_name" ]; then
                    match=1
                fi
            else
                # 移除 target_name 開頭的 ./（如果有的話）
                local clean_target="${target_name#./}"
                if [ "$original_path" = "/$clean_target" ] || [[ "$original_path" = */"$clean_target" ]]; then
                    match=1
                fi
            fi

            if [ $match -eq 1 ]; then
                found=1
                break 2
            fi
        done
    done
    
    if [ $found -eq 0 ]; then
        error_msg "在垃圾桶中找不到符合 '$target_name' 的刪除記錄或檔案本體"
        error_msg "No matching deletion record or file found in trash for '$target_name'"
        return 1
    fi
    
    # 決定還原目的地：目前資料夾下的相同檔名
    # Restore destination: same filename in the current folder
    local dest_filename=$(basename "$original_path")
    local dest_path="$(pwd)/$dest_filename"
    
    # 檢查目標路徑是否已存在同名檔案/目錄
    # Check if a file/directory with the same name already exists in the destination
    if [ -e "$dest_path" ] || [ -L "$dest_path" ]; then
        if [ "$force" != "1" ]; then
            echo -n "rm: 檔案或目錄 '$dest_filename' 已存在於目前資料夾，是否覆蓋？(y/N) " >&2
            read -r response
            if [[ ! "$response" =~ ^[yY] ]]; then
                echo "操作已取消 / Operation cancelled" >&2
                return 0
            fi
        fi
    fi
    
    # 執行還原：移動檔案
    if [ -e "$dest_path" ] || [ -L "$dest_path" ]; then
        /bin/rm -rf "$dest_path"
    fi
    
    if mv "$trash_path" "$dest_path" 2>/dev/null; then
        if [ "$verbose" = "1" ]; then
            success_msg "已還原 '$dest_filename' 到目前資料夾 (restored to: $dest_path)"
        fi
        return 0
    else
        error_msg "還原失敗：無法將檔案移回目前資料夾"
        error_msg "Restore failed: cannot move file back to current folder"
        return 1
    fi
}

# 垃圾桶項目名稱的比對模式：name__YYYYMMDD_HHMMSS_NNNNNNNNN__hash
# Glob matching trash item names: name__YYYYMMDD_HHMMSS_NNNNNNNNN__hash
TRASH_ITEM_GLOB='*__[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_*__*'

# 將 epoch 秒數轉為本地時間 YYYYMMDDHHMMSS（相容 GNU 與 BSD date）
# Format epoch seconds as local YYYYMMDDHHMMSS (compatible with GNU and BSD date)
format_epoch() {
    local epoch="$1"
    date -d "@$epoch" +%Y%m%d%H%M%S 2>/dev/null || date -r "$epoch" +%Y%m%d%H%M%S 2>/dev/null
}

# 比較垃圾桶項目名稱中的刪除時間與截止時間
# Compare the deletion timestamp embedded in a trash item name with the cutoff
# 回傳 (Returns): 0 = 已過期 (expired), 1 = 未過期 (not expired), 2 = 非垃圾桶項目 (not a trash item)
trash_item_expired() {
    local name="${1##*/}"
    local cutoff="$2"
    # 時間戳記位於倒數第二個 "__" 欄位，原始檔名本身也可能含有 "__"
    # The timestamp is the second-to-last "__" field; the original name may itself contain "__"
    local rest="${name%__*}"
    local ts="${rest##*__}"
    local re='^([0-9]{8})_([0-9]{6})_'
    if [[ ! "$ts" =~ $re ]]; then
        return 2
    fi
    (( 10#${BASH_REMATCH[1]}${BASH_REMATCH[2]} <= 10#$cutoff ))
}

# 檢查目錄內是否含有不符合清除條件（未過期或原始路徑不符）的垃圾桶項目
# Check whether a directory contains any trash item that does not match the purge conditions (not expired, or original path outside the prefixes)
# 若原始路徑的上層目錄名稱剛好符合垃圾桶格式，該目錄其實是路徑結構目錄，不能整個刪除
# If an ancestor of an original path happens to match the trash name format, that directory is
# really part of the path structure and must not be removed as a whole
contains_unmatched_trash_item() {
    local dir="$1"
    local cutoff="$2"
    local nested
    while IFS= read -r -d '' nested; do
        trash_item_matches "$nested" "$cutoff"
        if [ $? -eq 1 ]; then
            return 0
        fi
    done < <(find "$dir" -mindepth 1 -name "$TRASH_ITEM_GLOB" -print0 2>/dev/null)
    return 1
}

# 取得項目實際佔用的磁碟空間 (KiB)，無法取得時回傳 0
# Get the disk space actually allocated to an item (KiB); prints 0 when unavailable
disk_usage_kib() {
    local usage
    usage=$(du -sk -- "$1" 2>/dev/null)
    usage="${usage%%[[:space:]]*}"
    if [[ ! "$usage" =~ ^[0-9]+$ ]]; then
        usage=0
    fi
    echo "$usage"
}

# 將 KiB 數值格式化為易讀的大小，例如 1536 -> 1.5 MiB
# Format a KiB value as a human-readable size, e.g. 1536 -> 1.5 MiB
format_kib() {
    local value="$1"
    local units=(KiB MiB GiB TiB)
    local i=0
    local remainder=0
    while [ "$value" -ge 1024 ] && [ $i -lt 3 ]; do
        remainder=$((value % 1024))
        value=$((value / 1024))
        i=$((i + 1))
    done
    if [ $i -eq 0 ]; then
        echo "$value ${units[$i]}"
    else
        echo "$value.$((remainder * 10 / 1024)) ${units[$i]}"
    fi
}

# 取得指定年月的天數（含閏年判斷）
# Get the number of days in the given year and month (leap years included)
days_in_month() {
    local year=$((10#$1))
    local month=$((10#$2))
    case "$month" in
        1|3|5|7|8|10|12) echo 31 ;;
        4|6|9|11) echo 30 ;;
        *)
            if (( (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 )); then
                echo 29
            else
                echo 28
            fi
            ;;
    esac
}

# 解析 --purge 的時間條件，結果存入 PURGE_CUTOFF 與 PURGE_LABEL_ZH / PURGE_LABEL_EN
# Parse the --purge age spec into PURGE_CUTOFF and PURGE_LABEL_ZH / PURGE_LABEL_EN
# 支援 (Supported): 30 / 30d (天 days)、2w (週 weeks)、3m (月 months)、
#                   YYYY-MM-DD、YYYY-MM-DD HH:MM[:SS]、YYYY-MM-DDTHH:MM[:SS]
# PURGE_CUTOFF 為本地時間 YYYYMMDDHHMMSS，刪除時間小於等於它的項目視為過期；0 表示沒有項目過期
# PURGE_CUTOFF is local YYYYMMDDHHMMSS; items deleted at or before it are expired; 0 means nothing expires
parse_purge_age() {
    local spec="$1"
    local relative_re='^([0-9]+)([dDwWmM]?)$'
    local absolute_re='^([0-9]{4})-([0-9]{2})-([0-9]{2})([T ]([0-9]{2}):([0-9]{2})(:([0-9]{2}))?)?$'
    local now_epoch now_str

    PURGE_CUTOFF=""
    PURGE_LABEL_ZH=""
    PURGE_LABEL_EN=""

    now_epoch=$(date +%s)
    now_str=$(format_epoch "$now_epoch")
    if [ -z "$now_str" ]; then
        error_msg "無法計算截止時間"
        error_msg "Failed to compute purge cutoff time"
        return 1
    fi

    if [[ "$spec" =~ $relative_re ]] && [ ${#BASH_REMATCH[1]} -le 6 ]; then
        local count=$((10#${BASH_REMATCH[1]}))
        local unit="${BASH_REMATCH[2]}"
        case "$unit" in
            m|M)
                # 以日曆月份回推，並將日期限制在目標月份的天數內（例如 3/31 減 1 個月為 2/28 或 2/29）
                # Step back by calendar months and clamp the day to the target month (e.g. Mar 31 minus 1 month is Feb 28/29)
                local total=$((10#${now_str:0:4} * 12 + 10#${now_str:4:2} - 1 - count))
                if [ "$total" -lt 12000 ]; then
                    PURGE_CUTOFF=0
                else
                    local target_year=$((total / 12))
                    local target_month=$((total % 12 + 1))
                    local target_day=$((10#${now_str:6:2}))
                    local max_day
                    max_day=$(days_in_month "$target_year" "$target_month")
                    if [ "$target_day" -gt "$max_day" ]; then
                        target_day=$max_day
                    fi
                    PURGE_CUTOFF=$(printf '%04d%02d%02d%s' "$target_year" "$target_month" "$target_day" "${now_str:8:6}")
                fi
                PURGE_LABEL_ZH="超過 $count 個月"
                PURGE_LABEL_EN="older than $count months"
                ;;
            *)
                local seconds
                if [ "$unit" = "w" ] || [ "$unit" = "W" ]; then
                    seconds=$((count * 7 * 86400))
                    PURGE_LABEL_ZH="超過 $count 週"
                    PURGE_LABEL_EN="older than $count weeks"
                else
                    seconds=$((count * 86400))
                    PURGE_LABEL_ZH="超過 $count 天"
                    PURGE_LABEL_EN="older than $count days"
                fi
                if [ $((now_epoch - seconds)) -lt 0 ]; then
                    PURGE_CUTOFF=0
                else
                    PURGE_CUTOFF=$(format_epoch $((now_epoch - seconds)))
                fi
                ;;
        esac
    elif [[ "$spec" =~ $absolute_re ]]; then
        local year="${BASH_REMATCH[1]}"
        local month="${BASH_REMATCH[2]}"
        local day="${BASH_REMATCH[3]}"
        local hour="${BASH_REMATCH[5]:-00}"
        local minute="${BASH_REMATCH[6]:-00}"
        local second="${BASH_REMATCH[8]:-00}"
        if [ $((10#$month)) -lt 1 ] || [ $((10#$month)) -gt 12 ] || [ $((10#$day)) -lt 1 ] || \
           [ $((10#$day)) -gt "$(days_in_month "$year" "$month")" ] || \
           [ $((10#$hour)) -gt 23 ] || [ $((10#$minute)) -gt 59 ] || [ $((10#$second)) -gt 59 ]; then
            error_msg "無效的日期或時間: '$spec'"
            error_msg "invalid date or time: '$spec'"
            return 1
        fi
        PURGE_CUTOFF="${year}${month}${day}${hour}${minute}${second}"
        if [ $((10#$PURGE_CUTOFF)) -gt $((10#$now_str)) ]; then
            error_msg "指定的時間在未來: '$spec'"
            error_msg "the specified time is in the future: '$spec'"
            return 1
        fi
        local display="${year}-${month}-${day} ${hour}:${minute}:${second}"
        PURGE_LABEL_ZH="早於 $display"
        PURGE_LABEL_EN="older than $display"
    else
        error_msg "無效的時間條件: '$spec'（可用天數 30 / 30d、週數 2w、月數 3m，或日期時間 2026-01-31、'2026-01-31 14:30'）"
        error_msg "invalid age: '$spec' (use days 30 / 30d, weeks 2w, months 3m, or a date/time like 2026-01-31 or '2026-01-31 14:30')"
        return 1
    fi

    if [ -z "$PURGE_CUTOFF" ]; then
        error_msg "無法計算截止時間"
        error_msg "Failed to compute purge cutoff time"
        return 1
    fi
}

# 解析 --purge-path 的原始路徑前綴，結果存入 PURGE_PATH_PREFIXES（比對用）與 PURGE_PATH_DISPLAY（顯示用）
# Resolve the --purge-path prefixes into PURGE_PATH_PREFIXES (for matching) and PURGE_PATH_DISPLAY (for messages)
# 垃圾桶中記錄的是解析過符號連結的絕對路徑（例如 macOS 的 /tmp 會變成 /private/tmp），
# 而原目錄常已不存在，所以同時加入「正規化後」與「由最近存在的上層目錄解析後」兩種形式
# The trash records symlink-resolved absolute paths (e.g. /tmp becomes /private/tmp on macOS) and the
# original directory is often gone, so both the normalized and the nearest-existing-ancestor-resolved forms are matched
# 前綴以目錄為界：/a/foo 符合 /a/foo 與 /a/foo/...，但不符合 /a/foobar；根目錄 "/" 以空字串表示
# Prefixes match on directory boundaries: /a/foo matches /a/foo and /a/foo/... but not /a/foobar; the root "/" is stored as ""
resolve_purge_paths() {
    local input prefix existing tail real resolved
    PURGE_PATH_PREFIXES=()
    PURGE_PATH_DISPLAY=()

    for input in "${PURGE_PATH_INPUTS[@]}"; do
        if [ -z "$input" ]; then
            error_msg "選項 '--purge-path' 的路徑不可為空"
            error_msg "option '--purge-path' requires a non-empty path"
            return 1
        fi
        if [[ "$input" = /* ]]; then
            prefix="$input"
        else
            prefix="$(pwd)/$input"
        fi
        prefix=$(normalize_path "$prefix")
        prefix="${prefix%/}"
        PURGE_PATH_PREFIXES+=("$prefix")
        PURGE_PATH_DISPLAY+=("${prefix:-/}")

        existing="${prefix:-/}"
        tail=""
        while [ "$existing" != "/" ] && [ ! -e "$existing" ] && [ ! -L "$existing" ]; do
            tail="/${existing##*/}$tail"
            existing="${existing%/*}"
            [ -z "$existing" ] && existing="/"
        done
        real=$(readlink -f "$existing" 2>/dev/null)
        [ -z "$real" ] && real=$(realpath "$existing" 2>/dev/null)
        if [ -n "$real" ]; then
            resolved="${real%/}$tail"
            if [ "$resolved" != "$prefix" ]; then
                PURGE_PATH_PREFIXES+=("$resolved")
            fi
        fi
    done
}

# 還原垃圾桶項目的原始路徑 / Recover a trash item's original path
# 檢查垃圾桶項目的原始路徑是否位於任一 --purge-path 前綴之下（未指定前綴時一律符合）
# Check whether a trash item's original path is under any --purge-path prefix (always true when none was given)
# 原始路徑由垃圾桶內的相對位置還原：去掉垃圾桶根目錄與結尾的 __時間戳記__雜湊
# The original path is recovered from the item's location: strip the trash root and the trailing __timestamp__hash
trash_item_original_path() {
    local original="${1#"$PURGE_TRASH_ROOT"}"
    original="${original%__*}"
    original="${original%__*}"
    echo "$original"
}

trash_item_path_matches() {
    local original prefix
    if [ ${#PURGE_PATH_PREFIXES[@]} -eq 0 ]; then
        return 0
    fi
    original=$(trash_item_original_path "$1")
    for prefix in "${PURGE_PATH_PREFIXES[@]}"; do
        if [ "$original" = "$prefix" ] || [[ "$original" = "$prefix"/* ]]; then
            return 0
        fi
    done
    return 1
}

# 判斷垃圾桶項目是否符合所有清除條件（時間與原始路徑）
# Check whether a trash item matches every purge condition (age and original path)
# 回傳 (Returns): 0 = 符合 (match), 1 = 不符合 (no match), 2 = 非垃圾桶項目 (not a trash item)
trash_item_matches() {
    local status
    trash_item_expired "$1" "$2"
    status=$?
    if [ $status -ne 0 ]; then
        return $status
    fi
    trash_item_path_matches "$1" || return 1
}

# 從單一刪除日誌移除指定項目（及其內部項目）的記錄，輸出被移除的筆數
# Remove records of the given purged items (and anything nested inside them) from one deletion log; prints the number removed
# dry_run=1 時只計算筆數，不改寫日誌；只有實際有記錄要移除時才會改寫日誌
# With dry_run=1 it only counts; the log is rewritten only when there are records to remove
# 日誌行格式不符時一律保留，寧可多留不可誤刪
# Lines that do not parse are always kept: better to leave a stale record than drop a valid one
prune_deletion_log() {
    local log_file="$1"
    local paths_file="$2"
    local dry_run="$3"
    local log_dir="${log_file%/*}"
    local tmp_log tmp_count removed

    if [ ! -f "$log_file" ]; then
        echo 0
        return 0
    fi

    tmp_count=$(mktemp "${TMPDIR:-/tmp}/better-rm-count.XXXXXX" 2>/dev/null) || return 1
    if [ "$dry_run" = "1" ]; then
        tmp_log=/dev/null
    elif ! tmp_log=$(mktemp "$log_dir/.deletion-log.XXXXXX" 2>/dev/null); then
        rm -f "$tmp_count"
        return 1
    fi

    # 垃圾桶路徑是第 3 欄；比對前先合併重複的斜線（TRASH_DIR 結尾有 / 時日誌會記成 //）
    # The trash path is field 3; collapse repeated slashes first (a TRASH_DIR ending in / is logged with //)
    if ! awk -v countfile="$tmp_count" '
        BEGIN { FS = " [|] " }
        function norm(p) {
            gsub(/\/+/, "/", p)
            if (length(p) > 1) sub(/\/$/, "", p)
            return p
        }
        FILENAME == ARGV[1] {
            if ($0 != "") purged[norm($0)] = 1
            next
        }
        /^#/ || $0 == "" { print; next }
        {
            if (NF == 5) {
                p = norm($3)
                while (p != "") {
                    if (p in purged) { removed++; next }
                    if (p !~ /\//) break
                    sub(/\/[^\/]*$/, "", p)
                }
            }
            print
        }
        END { print removed + 0 > countfile }
    ' "$paths_file" "$log_file" > "$tmp_log" 2>/dev/null; then
        rm -f "$tmp_count"
        [ "$tmp_log" != "/dev/null" ] && rm -f "$tmp_log"
        return 1
    fi

    removed=$(cat "$tmp_count" 2>/dev/null)
    rm -f "$tmp_count"
    removed="${removed:-0}"

    if [ "$dry_run" != "1" ]; then
        if [ "$removed" -gt 0 ]; then
            if ! mv -f "$tmp_log" "$log_file" 2>/dev/null; then
                rm -f "$tmp_log"
                return 1
            fi
        else
            rm -f "$tmp_log"
        fi
    fi
    echo "$removed"
}

# 清理新舊兩份刪除日誌（還原功能會同時讀取兩者），輸出被移除的總筆數
# Prune both the current and the legacy deletion log (restore reads both); prints the total number removed
prune_deletion_logs() {
    local paths_file="$1"
    local dry_run="$2"
    local total=0
    local log_file count

    for log_file in "$(get_deletion_log_file)" "$TRASH_DIR/.deletion_log"; do
        if count=$(prune_deletion_log "$log_file" "$paths_file" "$dry_run"); then
            total=$((total + count))
        else
            warn_msg "無法清理刪除日誌: $log_file"
            warn_msg "Failed to prune deletion log: $log_file"
        fi
    done
    echo "$total"
}

# 依時間與原始路徑條件找出垃圾桶項目，供 --purge 與 --list 共用
# Collect trash items matching the age and original-path conditions, shared by --purge and --list
# 結果存入 COLLECT_ITEMS / COLLECT_SIZES (KiB) / COLLECT_TOTAL_KIB / COLLECT_LABEL_ZH / COLLECT_LABEL_EN / COLLECT_CUTOFF_DISPLAY
# 回傳 (Returns): 0 = 成功 (ok), 1 = 錯誤 (error), 2 = 垃圾桶目錄不存在 (trash directory does not exist)
collect_trash_items() {
    local age_spec="$1"
    local age_given="$2"
    local for_purge="$3"
    local label_zh=""
    local label_en=""

    # 未指定時間條件（只用 --purge-path）時，不限制刪除時間
    # Without an age spec (--purge-path only) the deletion time is unrestricted
    if [ "$age_given" = "1" ]; then
        parse_purge_age "$age_spec" || return 1
        label_zh="$PURGE_LABEL_ZH"
        label_en="$PURGE_LABEL_EN"
    else
        PURGE_CUTOFF=99999999999999
    fi
    local cutoff="$PURGE_CUTOFF"

    resolve_purge_paths || return 1
    if [ ${#PURGE_PATH_DISPLAY[@]} -gt 0 ]; then
        local joined="${PURGE_PATH_DISPLAY[0]}"
        local k
        for ((k=1; k<${#PURGE_PATH_DISPLAY[@]}; k++)); do
            joined="$joined, ${PURGE_PATH_DISPLAY[k]}"
        done
        if [ "$age_given" = "1" ]; then
            label_zh="原始路徑在 $joined 之下且$label_zh"
            label_en="originally under $joined and $label_en"
        else
            label_zh="原始路徑在 $joined 之下"
            label_en="originally under $joined"
        fi
    fi

    # 垃圾桶位置設定錯誤時，永久刪除可能波及垃圾桶以外的檔案，因此清除前先嚴格檢查（列出時不需要）
    # A misconfigured trash location could make a permanent purge reach files outside the trash, so validate strictly before purging (not needed for listing)
    if [ "$for_purge" = "1" ]; then
        if [[ "$TRASH_DIR" != /* ]]; then
            error_msg "垃圾桶目錄必須是絕對路徑: '$TRASH_DIR'"
            error_msg "Trash directory must be an absolute path: '$TRASH_DIR'"
            return 1
        fi
        if is_protected "$TRASH_DIR"; then
            error_msg "拒絕清除受保護的目錄: '$TRASH_DIR'"
            error_msg "Refused to purge protected directory: '$TRASH_DIR'"
            return 1
        fi
    fi
    if [ ! -d "$TRASH_DIR" ]; then
        return 2
    fi
    # macOS 的 ~/.Trash 需要「完全取用磁碟」權限才能讀取
    # Reading ~/.Trash on macOS requires Full Disk Access
    if ! ls -A "$TRASH_DIR" >/dev/null 2>&1; then
        error_msg "無法讀取垃圾桶目錄: $TRASH_DIR"
        error_msg "Cannot read trash directory: $TRASH_DIR"
        return 1
    fi

    local trash_root="$TRASH_DIR"
    while [[ "$trash_root" = */ ]]; do
        trash_root="${trash_root%/}"
    done

    PURGE_TRASH_ROOT="$trash_root"

    # 截止時間為本地時間，與垃圾桶檔名中的時間戳記一致（已由 parse_purge_age 計算）
    # The cutoff is local time, matching the timestamps in trash item names (computed by parse_purge_age)
    COLLECT_CUTOFF_DISPLAY=""
    if [ "$age_given" = "1" ] && [ ${#cutoff} -eq 14 ]; then
        COLLECT_CUTOFF_DISPLAY="${cutoff:0:4}-${cutoff:4:2}-${cutoff:6:2} ${cutoff:8:2}:${cutoff:10:2}:${cutoff:12:2}"
    fi

    # 找出過期項目；-prune 避免進入已刪除的目錄內部，只處理最上層的垃圾桶項目
    # Collect expired items; -prune keeps find out of trashed directories so only top-level trash items are considered
    COLLECT_ITEMS=()
    COLLECT_SIZES=()
    COLLECT_TOTAL_KIB=0
    local item size
    while IFS= read -r -d '' item; do
        if ! trash_item_matches "$item" "$cutoff"; then
            continue
        fi
        if [ -d "$item" ] && [ ! -L "$item" ] && contains_unmatched_trash_item "$item" "$cutoff"; then
            warn_msg "略過含有不符合條件項目的目錄: '$item'"
            warn_msg "Skipped directory containing trash items that do not match the conditions: '$item'"
            continue
        fi
        size=$(disk_usage_kib "$item")
        COLLECT_ITEMS+=("$item")
        COLLECT_SIZES+=("$size")
        COLLECT_TOTAL_KIB=$((COLLECT_TOTAL_KIB + size))
    done < <(find "$trash_root" -mindepth 1 -name "$TRASH_ITEM_GLOB" -prune -print0 2>/dev/null)

    COLLECT_LABEL_ZH="$label_zh"
    COLLECT_LABEL_EN="$label_en"
    return 0
}


# 列出垃圾桶中符合條件的項目（唯讀，不刪除任何東西）
# List trash items matching the conditions (read-only, nothing is deleted)
# 項目輸出到 stdout，依刪除時間由舊到新排序；統計摘要輸出到 stderr，方便搭配管線使用
# Rows go to stdout sorted by deletion time (oldest first); the summary goes to stderr so pipes stay clean
list_trash() {
    local age_spec="$1"
    local age_given="$2"

    collect_trash_items "$age_spec" "$age_given" 0
    local collect_status=$?
    if [ $collect_status -eq 2 ]; then
        echo "垃圾桶目錄不存在 (Trash directory does not exist): $TRASH_DIR" >&2
        return 0
    elif [ $collect_status -ne 0 ]; then
        return 1
    fi

    if [ ${#COLLECT_ITEMS[@]} -eq 0 ]; then
        if [ -n "$COLLECT_LABEL_ZH" ]; then
            echo "垃圾桶中沒有${COLLECT_LABEL_ZH}的項目 (No trash items $COLLECT_LABEL_EN)" >&2
        else
            echo "垃圾桶是空的 (No trash items)" >&2
        fi
        return 0
    fi

    local rows=""
    local files=0 dirs=0 links=0
    local i item raw_ts type
    for ((i=0; i<${#COLLECT_ITEMS[@]}; i++)); do
        item="${COLLECT_ITEMS[i]}"
        raw_ts="${item##*/}"
        raw_ts="${raw_ts%__*}"
        raw_ts="${raw_ts##*__}"
        if [ -L "$item" ]; then
            type="symlink"
            links=$((links + 1))
        elif [ -d "$item" ]; then
            type="directory"
            dirs=$((dirs + 1))
        else
            type="file"
            files=$((files + 1))
        fi
        rows="${rows}${raw_ts}"$'\t'"${COLLECT_SIZES[i]}"$'\t'"${type}"$'\t'"$(trash_item_original_path "$item")"$'\n'
    done

    local ts size_kib original
    printf '%s' "$rows" | LC_ALL=C sort | while IFS=$'\t' read -r ts size_kib type original; do
        printf '%s-%s-%s %s:%s:%s  %9s  %-9s %s\n' \
            "${ts:0:4}" "${ts:4:2}" "${ts:6:2}" "${ts:9:2}" "${ts:11:2}" "${ts:13:2}" \
            "$(format_kib "$size_kib")" "$type" "$original"
    done

    local total_size
    total_size=$(format_kib "$COLLECT_TOTAL_KIB")
    local condition_zh="" condition_en=""
    if [ -n "$COLLECT_LABEL_ZH" ]; then
        condition_zh="符合條件（${COLLECT_LABEL_ZH}）："
        condition_en=" matching (${COLLECT_LABEL_EN})"
    fi
    echo -e "${GREEN}${condition_zh}共 ${#COLLECT_ITEMS[@]} 個項目（$files 個檔案、$dirs 個目錄、$links 個符號連結），佔用約 ${total_size} (Total ${#COLLECT_ITEMS[@]} trash items${condition_en}: $files files, $dirs directories, $links symlinks, about ${total_size})${NC}" >&2
}

# 顯示垃圾桶摘要統計（唯讀）：總數與類型、佔用空間、最早/最新刪除時間、依刪除時間分佈、依原始目錄統計前五名
# Show summary statistics for the trash (read-only): totals and types, disk usage, oldest/newest deletion, age distribution, top original directories
# 可搭配 --purge <時間條件> / --purge-path <路徑> 當作篩選條件
# --purge <age> / --purge-path <path> act as filters here
stats_trash() {
    local age_spec="$1"
    local age_given="$2"

    collect_trash_items "$age_spec" "$age_given" 0
    local collect_status=$?
    if [ $collect_status -eq 2 ]; then
        echo "垃圾桶目錄不存在 (Trash directory does not exist): $TRASH_DIR"
        return 0
    elif [ $collect_status -ne 0 ]; then
        return 1
    fi

    if [ ${#COLLECT_ITEMS[@]} -eq 0 ]; then
        if [ -n "$COLLECT_LABEL_ZH" ]; then
            echo "垃圾桶中沒有${COLLECT_LABEL_ZH}的項目 (No trash items $COLLECT_LABEL_EN)"
        else
            echo "垃圾桶是空的 (No trash items)"
        fi
        return 0
    fi

    # 時間分佈的界線：以目前時間往回推，格式與垃圾桶檔名中的本地時間戳記相同
    # Age bucket boundaries: walk back from now, in the same local-time format as the names
    local now c1 c7 c30 c90
    now=$(date +%s)
    c1=$(format_epoch $((now - 86400)))
    c7=$(format_epoch $((now - 7 * 86400)))
    c30=$(format_epoch $((now - 30 * 86400)))
    c90=$(format_epoch $((now - 90 * 86400)))
    if [ -z "$c1" ] || [ -z "$c7" ] || [ -z "$c30" ] || [ -z "$c90" ]; then
        error_msg "無法計算統計用的時間界線"
        error_msg "Failed to compute age bucket boundaries"
        return 1
    fi

    local files=0 dirs=0 links=0
    local bucket_count=(0 0 0 0 0)
    local bucket_kib=(0 0 0 0 0)
    local oldest="" newest=""
    local dir_rows=""
    local i item raw_ts ts14 bucket original
    for ((i=0; i<${#COLLECT_ITEMS[@]}; i++)); do
        item="${COLLECT_ITEMS[i]}"
        raw_ts="${item##*/}"
        raw_ts="${raw_ts%__*}"
        raw_ts="${raw_ts##*__}"
        ts14="${raw_ts:0:8}${raw_ts:9:6}"

        if [ -L "$item" ]; then
            links=$((links + 1))
        elif [ -d "$item" ]; then
            dirs=$((dirs + 1))
        else
            files=$((files + 1))
        fi

        if [ -z "$oldest" ] || [ $((10#$ts14)) -lt $((10#$oldest)) ]; then
            oldest="$ts14"
        fi
        if [ -z "$newest" ] || [ $((10#$ts14)) -gt $((10#$newest)) ]; then
            newest="$ts14"
        fi

        if [ $((10#$ts14)) -gt $((10#$c1)) ]; then
            bucket=0
        elif [ $((10#$ts14)) -gt $((10#$c7)) ]; then
            bucket=1
        elif [ $((10#$ts14)) -gt $((10#$c30)) ]; then
            bucket=2
        elif [ $((10#$ts14)) -gt $((10#$c90)) ]; then
            bucket=3
        else
            bucket=4
        fi
        bucket_count[bucket]=$((bucket_count[bucket] + 1))
        bucket_kib[bucket]=$((bucket_kib[bucket] + COLLECT_SIZES[i]))

        original=$(trash_item_original_path "$item")
        original="${original%/*}"
        dir_rows="${dir_rows}${COLLECT_SIZES[i]}"$'\t'"${original:-/}"$'\n'
    done

    echo "垃圾桶統計 (Trash statistics)"
    echo "  位置 (Location):        $TRASH_DIR"
    if [ -n "$COLLECT_LABEL_ZH" ]; then
        echo "  篩選條件 (Filter):      ${COLLECT_LABEL_ZH} ($COLLECT_LABEL_EN)"
    fi
    echo "  項目數 (Items):         ${#COLLECT_ITEMS[@]}（檔案 ${files}、目錄 ${dirs}、符號連結 $links / files $files, directories $dirs, symlinks ${links}）"
    echo "  佔用空間 (Disk usage):  $(format_kib "$COLLECT_TOTAL_KIB")"
    echo "  最早刪除 (Oldest):      ${oldest:0:4}-${oldest:4:2}-${oldest:6:2} ${oldest:8:2}:${oldest:10:2}:${oldest:12:2}"
    echo "  最新刪除 (Newest):      ${newest:0:4}-${newest:4:2}-${newest:6:2} ${newest:8:2}:${newest:10:2}:${newest:12:2}"

    echo ""
    echo "依刪除時間分佈 (By age):"
    local labels=("1 天內 (< 1 day)" "1–7 天 (1–7 days)" "7–30 天 (7–30 days)" "30–90 天 (30–90 days)" "超過 90 天 (> 90 days)")
    for ((i=0; i<5; i++)); do
        printf '  %6d 項  %10s  %s\n' "${bucket_count[i]}" "$(format_kib "${bucket_kib[i]}")" "${labels[i]}"
    done

    echo ""
    echo "依原始目錄，佔用空間前五名 (Top 5 original directories by size):"
    local size_kib item_count dir_path
    printf '%s' "$dir_rows" | awk -F'\t' '{ size[$2] += $1; count[$2]++ } END { for (d in size) printf "%d\t%d\t%s\n", size[d], count[d], d }' \
        | LC_ALL=C sort -t$'\t' -k1,1nr -k3,3 | head -5 \
        | while IFS=$'\t' read -r size_kib item_count dir_path; do
            printf '  %10s  %6d 項  %s\n' "$(format_kib "$size_kib")" "$item_count" "$dir_path"
        done
}

# 永久刪除垃圾桶中符合時間條件的過期項目，並一併清除對應的刪除日誌記錄
# Permanently purge expired trash items matching the age spec, and prune their deletion log records
purge_trash() {
    local age_spec="$1"
    local force="$2"
    local verbose="$3"
    local dry_run="$4"
    local age_given="$5"

    collect_trash_items "$age_spec" "$age_given" 1
    local collect_status=$?
    if [ $collect_status -eq 2 ]; then
        echo "垃圾桶目錄不存在，沒有需要清除的項目 (Trash directory does not exist, nothing to purge)"
        return 0
    elif [ $collect_status -ne 0 ]; then
        return 1
    fi
    local label_zh="$COLLECT_LABEL_ZH"
    local label_en="$COLLECT_LABEL_EN"
    local cutoff_display="$COLLECT_CUTOFF_DISPLAY"
    local candidates=("${COLLECT_ITEMS[@]}")
    local candidate_sizes=("${COLLECT_SIZES[@]}")
    local total_kib="$COLLECT_TOTAL_KIB"
    local trash_root="$PURGE_TRASH_ROOT"
    local item

    if [ ${#candidates[@]} -eq 0 ]; then
        echo "垃圾桶中沒有${label_zh}的項目 (No trash items $label_en)"
        return 0
    fi

    local total_size
    total_size=$(format_kib "$total_kib")

    # 記錄被永久刪除的項目路徑，稍後據此清除刪除日誌
    # Track purged item paths so their deletion log records can be pruned afterwards
    local paths_file=""
    paths_file=$(mktemp "${TMPDIR:-/tmp}/better-rm-purged.XXXXXX" 2>/dev/null) || paths_file=""

    # 試執行：只列出預計刪除的項目與可釋放空間，不做任何變更
    # Dry run: only list what would be purged and the space it would free, without changing anything
    local i
    if [ "$dry_run" = "1" ]; then
        local dry_log_records=0
        for ((i=0; i<${#candidates[@]}; i++)); do
            echo "將永久刪除 (would purge) '${candidates[i]}' ($(format_kib "${candidate_sizes[i]}"))"
            if [ -n "$paths_file" ]; then
                printf '%s\n' "${candidates[i]}" >> "$paths_file"
            fi
        done
        if [ -n "$paths_file" ]; then
            dry_log_records=$(prune_deletion_logs "$paths_file" 1)
            rm -f "$paths_file"
        fi
        if [ -n "$cutoff_display" ]; then
            echo "截止時間 (cutoff): $cutoff_display"
        fi
        success_msg "試執行：將永久刪除 ${#candidates[@]} 個${label_zh}的項目，預計釋放約 ${total_size}，並清除 ${dry_log_records} 筆刪除日誌記錄 (Dry run: would purge ${#candidates[@]} trash items $label_en, freeing about $total_size, and remove $dry_log_records deletion log records)"
        return 0
    fi

    if [ "$force" != "1" ]; then
        # 先列出完整的項目清單（與 --dry-run 相同），讓使用者看清楚再確認；輸出到 stderr 以便與提示一起顯示
        # Show the full item list first (same as --dry-run) so the user sees exactly what will go; on stderr to stay next to the prompt
        for ((i=0; i<${#candidates[@]}; i++)); do
            echo "將永久刪除 (would purge) '${candidates[i]}' ($(format_kib "${candidate_sizes[i]}"))" >&2
        done
        if [ -n "$cutoff_display" ]; then
            echo "截止時間 (cutoff): $cutoff_display" >&2
        fi
        echo -n "rm: 永久刪除垃圾桶中 ${#candidates[@]} 個${label_zh}的項目（約 ${total_size}）？此操作無法復原 (permanently delete ${#candidates[@]} trash items $label_en (about $total_size)? This cannot be undone) (y/N) " >&2
        read -r response
        if [[ ! "$response" =~ ^[yY] ]]; then
            echo "操作已取消 / Operation cancelled" >&2
            [ -n "$paths_file" ] && rm -f "$paths_file"
            return 0
        fi
    fi

    local status=0
    local purged=0
    local freed_kib=0
    local parent
    for ((i=0; i<${#candidates[@]}; i++)); do
        item="${candidates[i]}"
        if ! /bin/rm -rf -- "$item" 2>/dev/null; then
            # 目錄內可能有唯讀子目錄（例如 Go 模組快取），補上寫入權限後重試
            # Trashed directories may contain read-only subdirectories (e.g. Go module cache); add write permission and retry
            if [ -d "$item" ] && [ ! -L "$item" ]; then
                chmod -R u+w -- "$item" 2>/dev/null
                /bin/rm -rf -- "$item" 2>/dev/null
            fi
        fi

        if [ -e "$item" ] || [ -L "$item" ]; then
            error_msg "無法永久刪除 '$item'"
            error_msg "Failed to purge '$item'"
            status=1
            continue
        fi

        purged=$((purged + 1))
        freed_kib=$((freed_kib + candidate_sizes[i]))
        if [ -n "$paths_file" ]; then
            printf '%s\n' "$item" >> "$paths_file"
        fi
        if [ "$verbose" = "1" ]; then
            success_msg "已永久刪除 '$item' (purged, $(format_kib "${candidate_sizes[i]}"))"
        fi

        # 移除因此變空的路徑結構目錄，但不刪除垃圾桶根目錄
        # Remove path-structure directories left empty, but never the trash root itself
        parent="${item%/*}"
        while [[ "$parent" = "$trash_root"/* ]] && rmdir -- "$parent" 2>/dev/null; do
            parent="${parent%/*}"
        done
    done

    # 被永久刪除的項目已無法還原，一併清除其刪除日誌記錄
    # Purged items can no longer be restored, so drop their deletion log records too
    local pruned_records=0
    if [ -z "$paths_file" ]; then
        warn_msg "無法建立暫存檔，已略過刪除日誌清理"
        warn_msg "Failed to create a temporary file, deletion log pruning skipped"
    elif [ -s "$paths_file" ]; then
        pruned_records=$(prune_deletion_logs "$paths_file" 0)
    fi
    [ -n "$paths_file" ] && rm -f "$paths_file"

    local freed_size
    freed_size=$(format_kib "$freed_kib")
    success_msg "已永久刪除 $purged 個${label_zh}的項目，釋放約 ${freed_size} (Purged $purged trash items $label_en, freed about $freed_size)"
    if [ "$pruned_records" -gt 0 ]; then
        success_msg "已清除 $pruned_records 筆刪除日誌記錄 (Removed $pruned_records deletion log records)"
    fi
    return $status
}

# 主程式
# Main program
main() {
    # 參數解析變數
    # Parameter parsing variables
    local recursive=0
    local force_mode=0
    local interactive=0
    local interactive_once=0
    local verbose=0
    local restore_mode=0
    local restore_target=""
    local purge_mode=0
    local purge_age=""
    local purge_age_given=0
    local list_mode=0
    local stats_mode=0
    local purge_paths=()
    local dry_run=0
    local files=()
    
    # 如果沒有參數，顯示錯誤
    # If no arguments, show error
    if [ $# -eq 0 ]; then
        error_msg "缺少操作對象"
        error_msg "missing operand"
        echo "Try 'rm --help' for more information." >&2
        return 1
    fi
    
    # 解析參數
    # Parse arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            --help)
                show_help
                return 0
                ;;
            --version)
                show_version
                return 0
                ;;
            --restore)
                restore_mode=1
                shift
                if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
                    restore_target="$1"
                    shift
                else
                    error_msg "選項 '--restore' 需要一個引數"
                    error_msg "option '--restore' requires an argument"
                    return 1
                fi
                ;;
            --purge)
                purge_mode=1
                shift
                if [ $# -gt 0 ]; then
                    purge_age="$1"
                    purge_age_given=1
                    shift
                else
                    error_msg "選項 '--purge' 需要一個引數（時間條件）"
                    error_msg "option '--purge' requires an argument (age)"
                    return 1
                fi
                ;;
            --purge=*)
                purge_mode=1
                purge_age="${1#--purge=}"
                purge_age_given=1
                shift
                ;;
            --list)
                list_mode=1
                shift
                ;;
            --stats)
                stats_mode=1
                shift
                ;;
            --purge-path)
                purge_mode=1
                shift
                if [ $# -gt 0 ]; then
                    purge_paths+=("$1")
                    shift
                else
                    error_msg "選項 '--purge-path' 需要一個引數（原始路徑前綴）"
                    error_msg "option '--purge-path' requires an argument (original path prefix)"
                    return 1
                fi
                ;;
            --purge-path=*)
                purge_mode=1
                purge_paths+=("${1#--purge-path=}")
                shift
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            -r|-R|--recursive)
                recursive=1
                shift
                ;;
            -f|--force)
                force_mode=1
                interactive=0  # -f 覆蓋 -i
                shift
                ;;
            -i)
                interactive=1
                force_mode=0  # -i 覆蓋 -f
                shift
                ;;
            -I)
                interactive_once=1
                shift
                ;;
            -v|--verbose)
                verbose=1
                shift
                ;;
            -rf|-fr|-Rf|-fR|-RF|-Fr|-rF|-RF)
                # 組合參數處理 - 只處理常見的 rf 組合
                # Handle combined parameters - only common rf combinations
                recursive=1
                force_mode=1
                interactive=0
                shift
                ;;
            -*)
                # 處理其他組合參數
                # Handle other combined parameters
                local arg="$1"
                shift
                local i
                local has_f=0
                local has_i=0
                local f_pos=-1
                local i_pos=-1
                
                # 第一次掃描：找出 f 和 i 的位置
                for ((i=1; i<${#arg}; i++)); do
                    case "${arg:$i:1}" in
                        f) has_f=1; f_pos=$i ;;
                        i) has_i=1; i_pos=$i ;;
                    esac
                done
                
                # 第二次掃描：處理所有選項
                for ((i=1; i<${#arg}; i++)); do
                    case "${arg:$i:1}" in
                        r|R) recursive=1 ;;
                        f) 
                            # 如果 i 也存在且在 f 之後，則 i 優先
                            if [ $has_i -eq 1 ] && [ $i_pos -gt $f_pos ]; then
                                : # 什麼都不做，讓 i 處理
                            else
                                force_mode=1
                                interactive=0
                            fi
                            ;;
                        i) 
                            # 如果 f 也存在且在 i 之後，則 f 優先
                            if [ $has_f -eq 1 ] && [ $f_pos -gt $i_pos ]; then
                                : # 什麼都不做，讓 f 處理
                            else
                                interactive=1
                                force_mode=0
                            fi
                            ;;
                        I) interactive_once=1 ;;
                        v) verbose=1 ;;
                        *)
                            error_msg "無效的選項 -- '${arg:$i:1}'"
                            error_msg "invalid option -- '${arg:$i:1}'"
                            echo "Try 'rm --help' for more information." >&2
                            return 1
                            ;;
                    esac
                done
                ;;
            *)
                files+=("$1")
                shift
                ;;
        esac
    done
    
    # 列出 / 統計模式：--purge / --purge-path 在此只當作篩選條件，不會刪除任何東西
    # List / stats mode: --purge / --purge-path act only as filters here and nothing is deleted
    if [ "$list_mode" = "1" ] || [ "$stats_mode" = "1" ]; then
        if [ "$list_mode" = "1" ] && [ "$stats_mode" = "1" ]; then
            error_msg "選項 '--list' 與 '--stats' 不能同時使用"
            error_msg "options '--list' and '--stats' cannot be used together"
            return 1
        fi
        if [ "$restore_mode" = "1" ] || [ "$dry_run" = "1" ] || [ ${#files[@]} -gt 0 ]; then
            error_msg "選項 '--list' / '--stats' 不能與 '--restore'、'--dry-run' 或檔案參數同時使用"
            error_msg "options '--list' / '--stats' cannot be combined with '--restore', '--dry-run' or file operands"
            return 1
        fi
        PURGE_PATH_INPUTS=("${purge_paths[@]}")
        if [ "$stats_mode" = "1" ]; then
            stats_trash "$purge_age" "$purge_age_given"
        else
            list_trash "$purge_age" "$purge_age_given"
        fi
        return $?
    fi

    # 試執行目前只支援清除模式
    # Dry run is currently supported only in purge mode
    if [ "$dry_run" = "1" ] && [ "$purge_mode" != "1" ]; then
        error_msg "選項 '--dry-run' 只能與 '--purge' 或 '--purge-path' 一起使用"
        error_msg "option '--dry-run' can only be used with '--purge' or '--purge-path'"
        return 1
    fi

    # 如果是清除模式
    # If in purge mode
    if [ "$purge_mode" = "1" ]; then
        if [ "$restore_mode" = "1" ] || [ ${#files[@]} -gt 0 ]; then
            error_msg "選項 '--purge' 與 '--purge-path' 不能與 '--restore' 或檔案參數同時使用"
            error_msg "options '--purge' and '--purge-path' cannot be combined with '--restore' or file operands"
            return 1
        fi
        PURGE_PATH_INPUTS=("${purge_paths[@]}")
        purge_trash "$purge_age" "$force_mode" "$verbose" "$dry_run" "$purge_age_given"
        return $?
    fi

    # 如果是還原模式
    # If in restore mode
    if [ "$restore_mode" = "1" ]; then
        restore_file "$restore_target" "$force_mode" "$verbose"
        return $?
    fi

    # 檢查是否有指定檔案
    # Check if files are specified
    if [ ${#files[@]} -eq 0 ]; then
        error_msg "缺少操作對象"
        error_msg "missing operand"
        echo "Try 'rm --help' for more information." >&2
        return 1
    fi
    
    # -I 選項：當刪除超過 3 個檔案時提示一次
    # -I option: prompt once when removing more than 3 files
    if [ "$interactive_once" = "1" ] && [ ${#files[@]} -gt 3 ]; then
        echo -n "rm: remove ${#files[@]} arguments? " >&2
        read -r response
        if [[ ! "$response" =~ ^[yY] ]]; then
            return 0
        fi
    fi
    
    # 確保垃圾桶目錄存在
    # Ensure trash directory exists
    if [ ! -d "$TRASH_DIR" ]; then
        mkdir -p "$TRASH_DIR" || {
            error_msg "無法建立垃圾桶目錄: $TRASH_DIR"
            error_msg "Failed to create trash directory: $TRASH_DIR"
            return 1
        }
    fi
    
    # 處理每個檔案
    # Process each file
    local status=0
    for file in "${files[@]}"; do
        # 檢查是否為目錄
        # Check if it's a directory
        if [ -d "$file" ] && [ ! -L "$file" ]; then
            if [ "$recursive" != "1" ]; then
                error_msg "無法移除 '$file': 是一個目錄"
                error_msg "cannot remove '$file': Is a directory"
                status=1
                continue
            fi
        fi
        
        # 互動式確認
        # Interactive confirmation
        if [ "$interactive" = "1" ]; then
            local prompt
            if [ -d "$file" ] && [ ! -L "$file" ]; then
                prompt="rm: descend into directory '$file'? "
            else
                prompt="rm: remove file '$file'? "
            fi
            echo -n "$prompt" >&2
            read -r response
            if [[ ! "$response" =~ ^[yY] ]]; then
                continue
            fi
        fi
        
        # 移動到垃圾桶
        # Move to trash
        if ! move_to_trash "$file" "$verbose"; then
            status=1
        fi
    done
    
    return $status
}

# 執行主程式
# Execute main program
# 同一行加上 exit，讓 bash 在 main 結束後不再往下讀檔案：腳本執行期間（例如等待確認提示時）若被覆寫更新，
# bash 會從舊的讀取位置繼續讀新內容而執行到殘缺片段
# Keep exit on the same line so bash never reads past main: if this file is overwritten while it runs
# (e.g. while waiting at a confirmation prompt), bash would otherwise resume at the old offset in the new content
main "$@"; exit $?
